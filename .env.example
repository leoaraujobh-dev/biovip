# GEMINI_API_KEY: Chave da API do Google Gemini (obtenha em https://aistudio.google.com/app/apikey).
# - No Cloudflare Pages: Configure em "Workers & Pages" > Seu Projeto > "Settings" > "Environment variables" > Add variable: GEMINI_API_KEY
# - Também aceita: GOOGLE_API_KEY ou VITE_GEMINI_API_KEY
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GEMINI_API_KEY: Opcional para compilação estática no Cloudflare Pages (bakes na build do Vite caso não utilize Pages Functions)
VITE_GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ASAAS_API_KEY: Token de Acesso da API Asaas (ex: $aact_YTU5YTE0M2M6N2I4...)
# Obtenha no painel do Asaas em: Minha Conta > Integração > Gerar nova chave de API.
# Usado para cobranças automáticas Pix com QR Code dinâmico, boletos, links de pagamento e assinaturas.
ASAAS_API_KEY=""

# ASAAS_ENVIRONMENT: "sandbox" para testes (sandbox.asaas.com) ou "production" para conta real (api.asaas.com).
ASAAS_ENVIRONMENT="sandbox"

# ASAAS_WEBHOOK_TOKEN: Token opcional de autenticação do Webhook configurado no painel do Asaas
# Endpoint do Webhook: https://biovip.com.br/api/asaas/webhook
ASAAS_WEBHOOK_TOKEN=""

# VITE_ADMIN_EMAIL: E-mail autorizado para acessar o painel de Administrador.
VITE_ADMIN_EMAIL="leoaraujobh@gmail.com"


