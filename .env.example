# =============================================================================
# LuxeBio Studio — Variáveis de Ambiente
# Copie para .env.local e preencha com suas chaves reais
# NUNCA commite .env.local (já está no .gitignore)
# =============================================================================

# ===== OBRIGATÓRIAS PARA PRODUÇÃO =====

# Email do super-admin (acesso total ao painel CRM + reset PIN)
VITE_ADMIN_EMAIL=admin@seudominio.com

# Google AI Studio (Gemini) - geração de conteúdo IA + scraping
# Obtenha em: https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=AIzaSy...

# Asaas Pagamentos - Chave da API
# Produção: https://www.asaas.com/minha-conta/api
# Sandbox: https://sandbox.asaas.com/minha-conta/api
ASAAS_API_KEY=$aas_sand_...  # ou $aas_prod_...
ASAAS_ENVIRONMENT=sandbox     # production | sandbox

# Asaas Webhook Token - valida assinatura dos webhooks
# Gere em: Asaas → Minha Conta → Webhooks → Novo Webhook
ASAAS_WEBHOOK_TOKEN=whsk_...

# Secret para API externa de criação de microsites (CRM externo)
# Gere string segura: openssl rand -hex 32
CRM_API_SECRET=gere-um-secret-seguro-aqui-com-32-caracteres-minimo

# Chave alternativa para admin API
VITE_ADMIN_API_KEY=admin-key-...

# Google Maps/Places API (opcional - enriquecimento de endereço)
# Console: https://console.cloud.google.com/apis/credentials
GOOGLE_API_KEY=AIzaSy...

# ===== OPCIONAIS =====

# Sentry Error Monitoring (ativa automaticamente se preenchido)
# Obtenha em: https://sentry.io/settings/projects/.../keys/
VITE_SENTRY_DSN=https://xxx@sentry.io/xxx

# Versão do release (usada no Sentry para tracking)
# Atualize a cada deploy: VITE_APP_VERSION=1.2.0
VITE_APP_VERSION=1.0.0

# Domínio base público (links de microsites, WhatsApp, etc.)
VITE_PUBLIC_BASE_DOMAIN=biovip.com.br

# =============================================================================
# NOTAS:
# - Variáveis com prefixo VITE_ ficam disponíveis no cliente (import.meta.env)
# - Variáveis SEM prefixo ficam apenas no servidor (Node/Vercel Functions)
# - Para desenvolvimento local: cp .env.example .env.local
# - Para Vercel: Settings → Environment Variables → adicione cada uma
# =============================================================================